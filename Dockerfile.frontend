# =============================================================================
# Dockerfile FRONTEND - Angular 21 multi-stage build
# Resultado: imagen nginx:alpine con el build estático del SPA
# =============================================================================

# --- Stage 1: Build Angular ---
FROM node:22-alpine AS build

WORKDIR /app

# Copiar package.json + lockfile primero (para cache de capas Docker)
COPY package.json pnpm-lock.yaml ./

# Instalar dependencias
RUN corepack enable && pnpm install --frozen-lockfile --prefer-offline

# Copiar el resto del código fuente
COPY . .

# Build producción
RUN pnpm exec ng build --configuration production

# --- Stage 2: Nginx para servir el SPA ---
FROM nginx:1.27-alpine

# Eliminar config por defecto
RUN rm -rf /etc/nginx/conf.d/default.conf /usr/share/nginx/html/*

# Copiar nuestra config de nginx (preparada para Ingress K8S)
COPY nginx.conf /etc/nginx/nginx.conf

# Copiar build de Angular al directorio de nginx
# Angular 21 con builder 'application' genera en dist/<proyecto>/browser/
COPY --from=build /app/dist/calendar-morocco-cli/browser /usr/share/nginx/html

# Puerto 80 dentro del contenedor
EXPOSE 80

# Health check para Kubernetes
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
